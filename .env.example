# ============================================================
# AI Fashion Mirror — environment configuration
# Copy to `.env` and adjust. All vars are optional; defaults below.
# ============================================================

# --- Models ---------------------------------------------------------
# Base URL hosting the MediaPipe wasm runtime + .task models.
# Default: self-hosted at /mediapipe (run `npm run models` once).
# For quick prototyping without downloading, use:
#   VITE_MEDIAPIPE_CDN=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
# (note: model .task files still need hosting; CDN base only covers wasm)
VITE_MEDIAPIPE_CDN=/mediapipe

# Pose model file inside VITE_MEDIAPIPE_CDN (public/mediapipe by default).
# Available: pose_landmarker_lite.task (5.5 MB, default)
#            pose_landmarker_full.task (9 MB, better accuracy)
VITE_POSE_MODEL_FILE=pose_landmarker_lite.task

# Person-segmentation model file.
VITE_SEGMENTATION_MODEL_FILE=selfie_segmenter.tflite

# --- Camera ---------------------------------------------------------
VITE_CAMERA_WIDTH=1280
VITE_CAMERA_HEIGHT=720
VITE_TARGET_FPS=30

# --- Pose engine ----------------------------------------------------
# GPU delegate (WebGL) is strongly recommended; set false only to debug.
VITE_POSE_DELEGATE_GPU=true
VITE_POSE_MIN_DETECTION_CONFIDENCE=0.5
VITE_POSE_MIN_TRACKING_CONFIDENCE=0.5
VITE_POSE_MIN_PRESENCE_CONFIDENCE=0.5

# --- Segmentation engine -------------------------------------------
VITE_SEGMENTATION_DELEGATE_GPU=true
VITE_ENABLE_SEGMENTATION=true

# --- Tracking stability ---------------------------------------------
# SMOOTHING_FACTOR: 0 = raw (jittery), 1 = frozen. 0.2–0.45 feels natural.
VITE_TRACKING_SMOOTHING_FACTOR=0.35
# Minimum torso landmark visibility to accept a pose for warping.
VITE_TRACKING_CONFIDENCE=0.55
# Coasting budget in frames: how long the garment rides the last pose
# when detection drops briefly (bridges blink-outs).
VITE_MAX_FRAMES_TO_SKIP=5

# --- Rendering / debug -----------------------------------------------
VITE_ENABLE_DEBUG_MODE=false
VITE_SHOW_LANDMARKS=true
VITE_SHOW_MASK=false
VITE_SHOW_PERFORMANCE=true

# --- Feature flags ---------------------------------------------------
VITE_ENABLE_OCCLUSION=true
VITE_ENABLE_BACKGROUND_REMOVAL=true

# --- Upload limits ----------------------------------------------------
# Max garment upload size in bytes (default 8 MB).
VITE_MAX_UPLOAD_BYTES=8388608

# --- Rendering / Wrinkles --------------------------------------------
# Enable realistic fabric wrinkle rendering (default: true)
VITE_ENABLE_WRINKLES=true
# Wrinkle intensity from subtle (0) to dramatic (1), default 0.6
VITE_WRINKLE_INTENSITY=0.6
# Prefer WebGPU over WebGL when available (default: true)
VITE_WEBGPU_PREFERRED=true

# --- Performance / Worker --------------------------------------------
# Run heavy pipeline stages in a Web Worker off the main thread (default: true)
VITE_USE_WORKER=true

# --- Garment Fit Shape Adjustments -----------------------------------
# (0 = tight/small, 1 = loose/large, default 0.5 for each)
VITE_FIT_BUST_DEFAULT=0.5
VITE_FIT_WAIST_DEFAULT=0.5
VITE_FIT_HIP_DEFAULT=0.5
VITE_FIT_HEIGHT_DEFAULT=0.5

# --- Authentication -------------------------------------------------
# Session validity in days before user must re-login (1-365, default 7)
VITE_AUTH_SESSION_DAYS=7

# --- Commerce -------------------------------------------------------
# Display currency code (ISO 4217), default 'INR'
VITE_COMMERCE_CURRENCY=INR

# --- Share / Recording ---------------------------------------------
# Maximum video recording length in seconds (1-600, default 30)
VITE_MAX_RECORD_SECONDS=30

# --- Cloth Physics Simulation --------------------------------------
# Enable experimental mass-spring cloth physics (default: false)
VITE_PHYSICS_ENABLED=false
